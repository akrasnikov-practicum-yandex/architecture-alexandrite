<mxfile host="65bd71144e">
    <diagram name="Logging-pipeline" id="logpipeline">
        <mxGraphModel dx="585" dy="438" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1320" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
