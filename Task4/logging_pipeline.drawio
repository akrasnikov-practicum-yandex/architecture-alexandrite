                            <mxPoint x="435" y="350"/>
                            <mxPoint x="435" y="420"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#6c8ebf;fontColor=#1a4d80;fontSize=11;strokeWidth=2;" parent="1" source="mesapi" target="vector" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="435" y="470"/>
                            <mxPoint x="435" y="420"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#6c8ebf;fontColor=#1a4d80;fontSize=11;strokeWidth=2;" parent="1" source="rabbit" target="vector" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="640" y="620"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e5" value="ES bulk (mTLS)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#82b366;fontColor=#2e5b1f;fontSize=11;strokeWidth=2;" parent="1" source="vector" target="es" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e6" value="query" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#d79b00;fontColor=#7a3b00;fontSize=11;strokeWidth=2;" parent="1" source="kibana" target="es" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e7" value="OIDC auth" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#999999;fontColor=#333333;fontSize=11;dashed=1;" parent="1" source="kibana" target="sso" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e8" value="alerts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#999999;fontColor=#333333;fontSize=11;dashed=1;" parent="1" source="kibana" target="alertmgr" edge="1">
                    <mxGeometry x="-0.1385" y="10" relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1440" y="520"/>
                        </Array>
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e9" value="deep-link по trace_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#999999;fontColor=#333333;fontSize=11;dashed=1;" parent="1" source="kibana" target="jaeger" edge="1">
                    <mxGeometry x="-0.3334" y="10" relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1440" y="480"/>
                        </Array>
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="legend" value="&lt;b&gt;Поток:&lt;/b&gt; приложения пишут структурированные JSON-логи в stdout → Vector (агент на каждом EC2: парсинг, обогащение, redaction PII) → Elasticsearch (индексы + ILM) → Kibana (поиск, дашборды, алерты).&lt;br&gt;Каждая запись несёт trace_id и correlation_id = order.id → связка с трассами Jaeger&amp;nbsp; и метриками Prometheus. Серым пунктиром — переиспользуемые компоненты." style="text;html=1;align=left;verticalAlign=middle;fillColor=#f9f9f9;strokeColor=#cccccc;fontColor=#333333;fontSize=12;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="80" y="800" width="1160" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="legendPII" value="&lt;b&gt;PII-redaction (в Vector) — что это:&lt;/b&gt; PII (Personally Identifiable Information) — персональные данные: email, ФИО, телефон, адрес, номер карты, payment token, подписанный S3-URL.&lt;br&gt;Логи чистятся в приложении (не пишем PII в лог) + в Vector (transform / VRL затирает значения по regex как страховка) — до отправки в Elasticsearch.&lt;br&gt;В лог попадают только идентификаторы-ссылки: order_id, customer_id, partner_id (а не сами персональные данные). Цель — не хранить персональные данные в системе логов (152-ФЗ / GDPR)." style="text;html=1;align=left;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#2e5b1f;fontSize=12;spacing=8;" vertex="1" parent="1">
                    <mxGeometry x="80" y="900" width="1140" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="legendAtRest" value="&lt;b&gt;Шифрование at-rest (Elasticsearch) — что это:&lt;/b&gt; данные «в покое» — файлы индексов, снапшоты, бэкапы — лежат на диске в зашифрованном виде; ключ хранится отдельно в KMS.&#xa;Защищает на случай кражи диска / доступа к бэкапу / снапшоту тома: без ключа данные не прочитать. Дополняет redaction PII (чистит содержимое) и mTLS (защита in-transit Vector → Elasticsearch) — это defense in depth.&#xa;В Yandex Cloud Managed-сервисах включается на уровне сервиса (KMS)." style="text;html=1;align=left;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#7a3b00;fontSize=12;spacing=8;" vertex="1" parent="1">
                    <mxGeometry x="80" y="1030" width="1140" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="legendILM" value="&lt;b&gt;ILM hot / warm / cold (Elasticsearch) — что это:&lt;/b&gt; Index Lifecycle Management — автоматический перенос индексов логов между уровнями хранения по мере старения, ради баланса цена / скорость.&#xa;• hot — свежие логи: запись + частый поиск, быстрые SSD (разбор инцидентов «сейчас»). • warm — запись прекращена, читают реже → дешёвые/медленные ноды, force-merge, меньше реплик. • cold — редкий доступ, самое дешёвое хранение (searchable snapshots). • delete — по истечении retention индекс удаляется.&#xa;Переход hot → warm по возрасту/размеру (rollover). Реализует политику хранения из Task4 §8 (горячее 30 дней → архив → удаление)." style="text;html=1;align=left;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7a5b00;fontSize=12;spacing=8;" vertex="1" parent="1">
                    <mxGeometry x="80" y="1150" width="1140" height="110" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>