                <mxCell id="title" value="Технологический стек логирования: от приложений до анализа (раздел 6.1)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="60" y="30" width="1000" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="appcol" value="Приложения&#xa;(JSON-логи в stdout)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a4d80;fontSize=13;fontStyle=1;verticalAlign=top;spacingTop=10;dashPattern=8 4;" parent="1" vertex="1">
                    <mxGeometry x="80" y="120" width="320" height="640" as="geometry"/>
                </mxCell>
                <mxCell id="shopapi" value="&lt;b&gt;Shop API&lt;/b&gt;&lt;div&gt;Java / Spring Boot&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#1a4d80&quot;&gt;Logback + logstash-logback-encoder&lt;br&gt;MDC: trace_id / span_id / order_id&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontColor=#1a4d80;fontSize=12;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="110" y="180" width="260" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="crmapi" value="&lt;b&gt;CRM API&lt;/b&gt;&lt;div&gt;Java / Spring Boot&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#1a4d80&quot;&gt;Logback + logstash-logback-encoder&lt;br&gt;MDC: trace_id / span_id / order_id&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontColor=#1a4d80;fontSize=12;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="110" y="300" width="260" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="mesapi" value="&lt;b&gt;MES API&lt;/b&gt;&lt;div&gt;C# / .NET&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#1a4d80&quot;&gt;Serilog (Compact JSON)&lt;br&gt;enrich из Activity.Current&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontColor=#1a4d80;fontSize=12;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="110" y="420" width="260" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="rabbit" value="&lt;b&gt;RabbitMQ&lt;/b&gt;&lt;div&gt;брокер сообщений&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#1a4d80&quot;&gt;json log / встроенный плагин&lt;br&gt;DLQ-события&lt;/div&gt;" style="shape=cylinder3;size=12;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontColor=#1a4d80;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="130" y="560" width="220" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="vector" value="&lt;b&gt;Vector&lt;/b&gt;&lt;div&gt;агент на каждом EC2&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#2e5b1f&quot;&gt;&lt;br&gt;source: stdin / file / kubernetes_logs&lt;br&gt;↓&lt;br&gt;transform (VRL):&lt;br&gt;• parse JSON&lt;br&gt;• enrich (env, host)&lt;br&gt;• redact PII (email/phone/card)&lt;br&gt;↓&lt;br&gt;sink: elasticsearch (bulk)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#2e5b1f;fontSize=13;arcSize=10;verticalAlign=top;spacingTop=10;" parent="1" vertex="1">
                    <mxGeometry x="500" y="300" width="280" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="vectorlabel" value="Доставка / обработка" style="text;html=1;align=center;fontSize=13;fontStyle=1;fontColor=#2e5b1f;" parent="1" vertex="1">
                    <mxGeometry x="500" y="260" width="280" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="storecol" value="Хранение / анализ" style="text;html=1;align=center;fontSize=13;fontStyle=1;fontColor=#7a3b00;" parent="1" vertex="1">
                    <mxGeometry x="900" y="120" width="320" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="es" value="&lt;b&gt;Elasticsearch&lt;/b&gt;&lt;div style=&quot;font-size: 11px; color: rgb(122, 59, 0);&quot;&gt;хранение + индексация&lt;br&gt;data streams: logs-app-*,&lt;br&gt;logs-rabbitmq-*, logs-audit-order-*&lt;br&gt;ILM hot/warm/cold • шифр. at-rest&lt;br&gt;(тот же кластер, что под Jaeger)&lt;/div&gt;" style="shape=cylinder3;size=12;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#7a3b00;fontSize=13;verticalAlign=top;spacingTop=14;" parent="1" vertex="1">
                    <mxGeometry x="900" y="180" width="320" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="kibana" value="&lt;b&gt;Kibana&lt;/b&gt;&lt;div style=&quot;font-size:11px;color:#7a3b00&quot;&gt;поиск по order_id • дашборды&lt;br&gt;«Жизненный цикл заказа»&lt;br&gt;deep-link в Jaeger по trace_id&lt;br&gt;алертинг + поиск аномалий&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#7a3b00;fontSize=13;arcSize=10;verticalAlign=top;spacingTop=10;" parent="1" vertex="1">
                    <mxGeometry x="900" y="420" width="320" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="sso" value="&lt;b&gt;Identity Provider&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;OIDC SSO&lt;br&gt;RBAC: Support / Developer /&lt;br&gt;Partner / Admin&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;fontSize=12;arcSize=12;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="900" y="620" width="320" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="alertmgr" value="&lt;b&gt;AlertManager&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;Telegram / Email / PagerDuty&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;fontSize=12;arcSize=12;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="1300" y="575" width="280" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="jaeger" value="&lt;b&gt;Jaeger&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;трассы по trace_id&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;fontSize=12;arcSize=12;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="1300" y="220" width="280" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="e1" value="JSON logs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#6c8ebf;fontColor=#1a4d80;fontSize=11;strokeWidth=2;" parent="1" source="shopapi" target="vector" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#6c8ebf;fontColor=#1a4d80;fontSize=11;strokeWidth=2;" parent="1" source="crmapi" target="vector" edge="1">
                    <mxGeometry relative="1" as="geometry">
